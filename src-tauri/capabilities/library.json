{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "library",
  "description": "The Library window",
  "windows": ["library"],
  "permissions": [
    "core:default",
    "allow-session-start",
    "allow-session-control",
    "allow-session-estimate",
    "allow-vault-status",
    "allow-vault-choose-folder",
    "allow-vault-tree",
    "allow-vault-reveal",
    "allow-vault-search",
    "allow-library-pin",
    "allow-library-context-menu",
    "allow-platform-info",
    "allow-library-flushed",
    "allow-vault-read",
    "allow-vault-write",
    "allow-vault-create",
    "allow-vault-create-folder",
    "allow-vault-rename",
    "allow-vault-trash",
    "allow-settings-get",
    "allow-settings-set",
    "allow-capture-status",
    "allow-follow-stats"
